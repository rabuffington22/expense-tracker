# Required — generate with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET=changeme

# Optional — enables debug mode for local development
FLASK_DEBUG=1

# Optional — database, upload, and backup root; unset defaults to ./local_state
# DATA_DIR=

# Optional — display-name/database map override, primarily for the demo app
# ENTITIES=

# Optional — enables the server-rendered login gate
# APP_PASSWORD_HASH=

# Optional — Plaid credentials
# PLAID_CLIENT_ID=
# PLAID_SECRET=
# PLAID_ENV=sandbox

# Optional — bearer secret for the scheduled all-entity sync endpoint
# SYNC_SECRET=

# Optional — AI features
# OPENROUTER_API_KEY=

# Optional — Luxe Legacy downstream mirror; both values are required together
# LUXURY_SUPABASE_URL=
# LUXURY_SUPABASE_SERVICE_KEY=
